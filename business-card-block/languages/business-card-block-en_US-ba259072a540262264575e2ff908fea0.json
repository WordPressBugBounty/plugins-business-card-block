 page in Elementor where you want the business card.":[""],"Use the ShortCode Widget":[""],"Drop Elementor's ShortCode widget into a section and paste <code>[bcb id=\"X\"]<\/code> \u2014 your card renders instantly.":[""],"Theme \/ PHP":[""],"Build the Card":[""],"Create the ShortCode entry as usual, then copy its ID.":[""],"Manage Cards":[""],"Drop into a Template File":[""],"In any theme template, call <code>echo do_shortcode('[bcb id=\"123\"]');<\/code> where you want the card.":[""],"Style if Needed":[""],"Wrap the call in your own container to control width, spacing, or background per template.":[""],"Unlock premium business card Layouts.":[""],"Full typography control for all text.":[""],"Advanced background, border, and shadow styling.":[""],"Customize header, sidebar, and sections in detail.":[""],"Contact and social icon size and hover styling.":[""],"Decorative shapes and color customization options.":[""],"Style download button with full design controls.":[""],"Start Now":[""],"See All Demos":[""],"Theme 4":[""],"Theme 5":[""],"Theme 6":[""],"Theme 7":[""],"Theme 8":[""],"Buy Now \u279c":[""]}}}